{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_sha256",
    "works",
    "units",
    "reviewers",
    "annotations",
    "events",
    "adjudications"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "works": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "work_id",
          "title",
          "version",
          "modality"
        ],
        "properties": {
          "work_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "modality": {
            "enum": [
              "literature",
              "video"
            ]
          }
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "work_id",
          "unit_type",
          "locator"
        ],
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "work_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "unit_type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "locator": {
            "$ref": "#/$defs/locator"
          }
        }
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id"
        ],
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotation"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "annotation_id",
          "evidence_id",
          "presentation_order",
          "role"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "annotation_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "presentation_order": {
            "type": "integer",
            "minimum": 0
          },
          "story_order": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "setup",
              "expectation",
              "disruption",
              "reveal",
              "consequence"
            ]
          }
        }
      }
    },
    "adjudications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adjudication_id",
          "annotation_ids",
          "reviewer",
          "decision",
          "rationale"
        ],
        "properties": {
          "adjudication_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "annotation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "decision": {
            "enum": [
              "present",
              "absent",
              "uncertain",
              "not_applicable"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YalcinkayaE/lit_pattern/schemas/annotation-0.1.0",
  "title": "Proposed annotation bundle 0.1.0",
  "$defs": {
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "reference"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "start",
            "end"
          ],
          "properties": {
            "type": {
              "const": "timestamp"
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "description",
        "locator"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "quotation",
            "paraphrase",
            "timestamp_span",
            "visual_description",
            "audio_description",
            "knowledge_state",
            "inspection"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "inspection_scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "adequacy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "knowledge": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "holder",
              "information",
              "knows"
            ],
            "properties": {
              "holder": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "information": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "knows": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotation_id",
        "work_id",
        "unit_id",
        "pattern_id",
        "pattern_version",
        "schema_version",
        "presence",
        "rationale",
        "reviewer",
        "modality",
        "created_at",
        "evidence"
      ],
      "properties": {
        "annotation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "work_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "unit_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "pattern_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "pattern_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "presence": {
          "enum": [
            "present",
            "absent",
            "uncertain",
            "not_applicable"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "modality": {
          "enum": [
            "literature",
            "video"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "connection": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "function": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "proposed_effect": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
