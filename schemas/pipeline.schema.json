{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "normalisation_version",
    "schema_version",
    "validator_version",
    "source",
    "source_sha256",
    "annotation_schema",
    "pattern_version",
    "required_fields",
    "label_types",
    "unit_types",
    "status_mapping",
    "relation_types",
    "relation_decisions",
    "pattern_rules",
    "pattern_id_pattern"
  ],
  "properties": {
    "normalisation_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "validator_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "annotation_schema": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "pattern_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "required_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "label_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "unit_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "status_mapping": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": [
          "proposed",
          "drafted",
          "pilot_tested",
          "validated",
          "retired"
        ]
      }
    },
    "relation_types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "relation_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "relation_type",
          "rationale"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "relation_type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "pattern_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "roles",
          "min_locators",
          "min_events",
          "connection",
          "knowledge",
          "ordered_roles",
          "event_roles"
        ],
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "min_locators": {
            "type": "integer",
            "minimum": 1
          },
          "min_events": {
            "type": "integer",
            "minimum": 0
          },
          "connection": {
            "type": "boolean"
          },
          "knowledge": {
            "type": "boolean"
          },
          "ordered_roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "event_roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "pattern_id_pattern": {
      "type": "string",
      "minLength": 1,
      "format": "regex"
    }
  }
}
